{
  "version": 1,
  "tools": [
    {
      "id": "zapret",
      "title": "zapret",
      "match": {
        "process_names": [
          "winws.exe",
          "zapret.exe",
          "zapret-winws.exe",
          "blockcheck.exe",
          "nfqws.exe"
        ],
        "path_substrings": [
          "\\zapret\\",
          "/zapret/",
          "\\winws\\",
          "zapret-discord",
          "zapret_discord"
        ],
        "drivers": [
          "WinDivert",
          "WinDivert1.4",
          "WinDivert14"
        ]
      },
      "handles": {
        "app_names": [
          "discord.exe",
          "discordptb.exe",
          "discordcanary.exe",
          "discorddevelopment.exe"
        ],
        "domain_keywords": [
          "discord",
          "discordapp",
          "discord.gg",
          "youtube",
          "googlevideo",
          "youtu.be",
          "ytimg",
          "ggpht"
        ]
      },
      "when_overlap": {
        "severity": "warn",
        "message": "Обнаружен zapret (WinDivert). Пока включён VPN с TUN, Discord всё равно проходит через TUN — даже в режиме DIRECT (в соединениях видно «Tun»). Zapret на этом пути не работает. Выберите одно: 1) выключите VPN и пользуйтесь zapret; 2) оставьте VPN и пустите Discord через VPN (в белый список приложений / «Через VPN»), zapret для него не нужен; 3) не комбинируйте TUN+zapret+Discord одновременно."
      }
    },
    {
      "id": "goodbyedpi",
      "title": "GoodbyeDPI",
      "match": {
        "process_names": [
          "goodbyedpi.exe"
        ],
        "path_substrings": [
          "\\goodbyedpi\\",
          "/goodbyedpi/"
        ],
        "drivers": [
          "WinDivert",
          "WinDivert1.4"
        ]
      },
      "handles": {
        "app_names": [],
        "domain_keywords": []
      },
      "when_overlap": {
        "severity": "warn",
        "message": "Обнаружен GoodbyeDPI (WinDivert). Одновременная работа с TUN/split-tunnel может ломать отдельные приложения. Если что-то отваливается — выключите GoodbyeDPI или уберите приложение из списка VPN."
      }
    }
  ]
}
